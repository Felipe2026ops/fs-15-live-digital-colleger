<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hambuguer House</title>
    <link rel="stylesheet" href="style.css">
    <link href="https://googleapis.com" rel="stylesheet">
</head>
<body>

    <header class="header">
        <a href="#" class="logo">Hamburger<span>House</span></a>
        <nav class="navbar">
            <a href="#inicio">Inicio</a>
            <a href="#cardapio">Cardápio</a>
            <a href="#contato">Contato (85) 990054-2121</a>
            <a href="#Redes Sociais">Instagram: @HambuguerHouse</a>
        </nav>
    </header>

    <!-- Seção Principal (Hero) -->
    <section class="hero" id="inicio">
        <div class="hero-content">
            <img src="imagen/"logo alt="">
            <h1>O melhor Hambúrguer da Região.</h1>
            <p>Artesanal, suculento e preparado com ingredientes selecionados. Peça já o seu !</p>
            <a href="#cardapio" class="btn">Ver Cardápio</a>
            <a href="https://link-de-pagamento-da-sua-plataforma.com" target="_blank">
            </a>
         </div>
    </section>

    <!-- Seção de Cards (Cardápio) -->
    <section class="cardapio" id="cardapio">
        <h2 class="section-title">Confira o Nosso Cardápio !!!</h2>
        
        <div class="cards-container">
            
            <!-- CARD 1 -->
            <div class="card">
                <img src="imagen/burguer_1.png" alt="Burger Clássico" class="card-img">
                <div class="card-body">
                    <h3>Classic Burger</h3>
                    <p>Pão brioche, blend artesanal de 150g, queijo coalho derretido tomate e alface.</p>
                    <div class="card-price">R$ 23,90</div>
                    <a href="" class="btn-card">Adicionar</a>
                </div>
            </div>

            <!-- CARD 2 -->
            <div class="card">
                <img src="imagen/burger-2.png" alt="Double Cheddar" class="card-img">
                <div class="card-body">
                    
                    <h3>Burger duo Bacon</h3>
                    <p>Dois blends de 150g, muito queijo cheddar, tiras de bacon crocante cebola tomate  e batata frita.</p>
                    <div class="card-price">R$ 36,90</div>
                    <a href="#" class="btn-card">Adicionar</a>
                </div>
            </div>

            <!-- CARD 3 -->
            <div class="card">
                <img src="imagen/burguer 3.png" alt="Monster Burger" class="card-img">
                <div class="card-body">
                    <h3>Burger Monster</h3>
                    <p>Blend de 150g, queijo prato, cebola crispy dourada, alface, tomate e maionese verde.</p>
                    <div class="card-price">R$ 30,90</div>
                    <a href="#" class="btn-card">Adicionar</a>
                </div>
            </div>

        </div>
    </section>

    <!-- Rodapé -->
    <footer class="footer" id="contato">
        <p>&copy; 2026 Hambuger House. Todos os direitos reservados.</p>
    </footer>

</body>
</html>
